# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tooling and editor files
.vite/
.vite-temp/
.DS_Store
.idea/
.vscode/
*.swp
